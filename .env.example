# ASHA Saathi - Combined Voice (Person A) & AI Brain (Person B) Environment Template
# Copy to `.env` (or `backend/.env` / `voice/.env`) and fill in real credentials before live runs.
# NEVER commit `.env` or API keys to git.

# --- Person A: Gnani Prisma v3.0 STT & Timbre v3.0 TTS ---
GNANI_API_KEY=

# --- Person B: AI Brain LLM Provider ---
# Supported values:
#   "mock"              -> deterministic offline test mode (no external API calls)
#   "auto"              -> uses real LLM if API key & model are set; mock in dev otherwise
#   "openai"            -> OpenAI REST chat/completions
#   "openai_compatible" -> Groq / OpenRouter / vLLM / Ollama OpenAI-compatible APIs
#   "gemini"            -> Google Gemini REST generateContent
#   "anthropic"         -> Anthropic Messages REST API
LLM_PROVIDER=mock

# API key for selected provider (or set OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Set APP_ENV=production or REQUIRE_REAL_LLM=true to forbid mock fallback strictly
APP_ENV=development
REQUIRE_REAL_LLM=false

# Resilience & Extraction Validation
LLM_TIMEOUT_SECONDS=20
MAX_EXTRACTION_RETRIES=2

# Clinical & Localization Settings
APP_TIMEZONE=Asia/Kolkata
DANGER_SIGNS_PATH=data/danger_signs.json
LOG_LEVEL=INFO
