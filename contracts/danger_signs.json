    "default_referral_messages": {
      "hi-en": "Yeh ek danger sign hai. Kripya patient ko abhi nearest PHC refer karein.",
      "en": "This is a danger sign. Please refer the patient to the nearest PHC immediately.",
      "en-IN": "This is a danger sign. Please refer the patient to the nearest PHC immediately.",
      "hi": "यह एक खतरे का संकेत है। कृपया मरीज को तुरंत नजदीकी पीएचसी (PHC) में रेफर करें।",
      "hi-IN": "यह एक खतरे का संकेत है। कृपया मरीज को तुरंत नजदीकी पीएचसी (PHC) में रेफर करें।",
      "ta-IN": "இது ஒரு அபாய அறிகுறி. தயவுசெய்து நோயாளியை உடனடியாக அருகிலுள்ள PHC-க்கு பரிந்துரைக்கவும்.",
      "te-IN": "ఇది ప్రమాద సంకేతం. దయచేసి రోగిని వెంటనే సమీపంలోని PHCకి రిఫర్ చేయండి.",
      "bn-IN": "এটি একটি বিপদ সংকেত। অনুগ্রহ করে রোগীকে এখনই নিকটস্থ PHC-তে রেফার করুন।",
      "mr-IN": "हे धोक्याचे लक्षण आहे. कृपया रुग्णाला तात्काळ जवळच्या PHC मध्ये रेफर करा.",
      "gu-IN": "આ એક જોખમી સંકેત છે. કૃપા કરીને દર્દીને તરત જ નજીકના PHC માં રિફર કરો.",
      "kn-IN": "ಇದು ಅಪಾಯದ ಲಕ್ಷಣವಾಗಿದೆ. ದಯವಿಟ್ಟು ರೋಗಿಯನ್ನು ತಕ್ಷಣ ಹತ್ತಿರದ PHC ಗೆ ರೆಫರ್ ಮಾಡಿ.",
      "ml-IN": "ഇതൊരു അപകട ലക്ഷണമാണ്. ദയവായി രോഗിയെ ഉടൻ അടുത്തുള്ള PHC-യിലേക്ക് റഫർ ചെയ്യുക.",
      "pa-IN": "ਇਹ ਇੱਕ ਖ਼ਤਰੇ ਦਾ ਸੰਕੇਤ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਮਰੀਜ਼ ਨੂੰ ਤੁਰੰਤ ਨਜ਼ਦੀਕੀ PHC ਵਿੱਚ ਰੈਫਰ ਕਰੋ।"
    },
    "primary_source": {
      "title": "Job Aid for Home Visits by ASHA (Newborn and Young Child)",
      "publisher": "Child Health Division, MoHFW, Govt. of India",
      "year": 2018,
      "url": "https://hbnc-hbyc.mohfw.gov.in/assets/document/English-Job%20Aid%20for%20ASHA%20on%20HBYC.pdf",
      "note": "Page numbers are those printed on the job aid pages. Re-check before submission."
    },
    "language_verification": {
      "en-IN": "draft_needs_review",
      "hi-IN": "draft_needs_native_review",
      "others": "unverified_machine_generated"
    },
    "tiers": {
      "refer_now": "Clear match to a source-backed sign. Show red banner, speak referral, flag record.",
      "possible_confirm": "Ambiguous or weak mention. Show amber alert 'possible danger sign, please confirm' and ask the ASHA once. Never stay silent."
    },
    "possible_referral_messages": {
      "hi-en": "Yeh danger sign ho sakta hai. Kripya confirm karein, aur sahi ho to patient ko abhi nearest PHC refer karein.",
      "en": "This may be a danger sign. Please confirm, and if so, refer the patient to the nearest PHC immediately.",
      "hi": "यह खतरे का संकेत हो सकता है। कृपया पुष्टि करें, और सही हो तो मरीज को तुरंत नजदीकी पीएचसी में रेफर करें।"
    },
    "matching_rules": {
      "longest_match_wins": true,
      "weak_terms_rule": "A match on a weak_terms entry only gives possible_confirm; otherwise default_tier applies.",
      "negation_markers": [
        "nahi",
        "nahin",
        "nahi hai",
        "koi",
        "no",
        "not",
        "without",
        "नहीं",
        "कोई"
      ],
      "negation_window_tokens": 3,
      "negation_policy": "If a negation marker is within the window, do not raise an alert but log the mention in the record. Misheard negations are a risk, so also show it on screen.",
      "resolved_markers": [
        "stopped",
        "band ho gaya",
        "ruk gaya",
        "ठीक हो गया",
        "बंद हो गया"
      ],
      "resolved_policy": "A resolved marker gives possible_confirm (not silence) so the ASHA decides.",
      "unsure_policy": "When unsure, show possible_confirm. A missed sign costs more than an extra check.",
      "scope": "Matching decides which alert to show. The system gives no diagnosis or treatment advice."
    },
    "numeric_rules": [
      {
        "id": "newborn_low_weight",
        "applies_to": "newborn",
        "field": "weight_kg",
        "op": "<",
        "value": 1.8,
        "tier": "refer_now",
        "source_pages": [
          7,
          9
        ],
        "note": "Job aid: below 1.8 kg, advise KMC and expressed milk, and refer. Normalise grams to kg (1800 g = 1.8 kg). Always read weight back digit by digit (1.8 vs 2.8)."
      },
      {
        "id": "mother_high_temperature",
        "applies_to": "mother",
        "field": "temperature_f",
        "op": ">",
        "value": 102,
        "tier": "refer_now",
        "source_pages": [
          7
        ],
        "note": "Mother fever above 102 F."
      },
      {
        "id": "mother_pads_per_day",
        "applies_to": "mother",
