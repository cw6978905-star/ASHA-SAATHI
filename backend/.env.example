# ASHA Saathi - AI Brain (Person B) Environment Configuration
# Copy this file to .env and fill in credentials for your team's LLM provider.
# Never commit .env to git.

# LLM provider: "mock" (offline/deterministic), "openai", "openai_compatible", "gemini", or "anthropic"
LLM_PROVIDER=mock

# API key for the selected provider (leave blank when using LLM_PROVIDER=mock)
LLM_API_KEY=

# Model identifier for the selected provider (for example, your team's chosen Gemini/OpenAI/open-source model)
LLM_MODEL=

# Optional custom base URL for OpenAI-compatible or self-hosted endpoints (Groq, Ollama, vLLM, etc.)
LLM_BASE_URL=

# HTTP request timeout in seconds for external LLM calls
LLM_TIMEOUT_SECONDS=20

# Maximum JSON repair retries when LLM extraction returns malformed JSON
MAX_EXTRACTION_RETRIES=2

# Timezone used to resolve relative visit dates
APP_TIMEZONE=Asia/Kolkata

# Path to configurable verified danger-sign dataset (relative to backend/ or absolute)
DANGER_SIGNS_PATH=data/danger_signs.json

# Logging level (INFO, DEBUG, WARNING, ERROR) - transcripts and secrets are never logged
LOG_LEVEL=INFO

# Configurable introductory AI disclosure message (also handled by Person A voice pipeline)
AI_INTRO_MESSAGE_HI_EN="Namaste, main ASHA Saathi AI assistant hoon. Main visit record bharne mein madad karoongi, lekin main doctor nahi hoon aur dawai ya ilaj ki salah nahi de sakti."
AI_INTRO_MESSAGE_EN="Hello, I am the ASHA Saathi AI assistant. I help record visit details, but I am not a doctor and cannot give medical or treatment advice."
AI_INTRO_MESSAGE_HI="नमस्ते, मैं आशा साथी AI असिस्टेंट हूँ। मैं विजिट रिकॉर्ड भरने में मदद करूँगी, लेकिन मैं डॉक्टर नहीं हूँ और दवा या इलाज की सलाह नहीं दे सकती।"
